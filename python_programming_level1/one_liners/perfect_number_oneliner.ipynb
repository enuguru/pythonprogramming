   "source": [
    "import time\n",
    "start = time.time()\n",
    "for num in range(2,10000):\n",
    "    sum = 0\n",
    "    for val in range(1,num):\n",
    "        if num % val == 0:\n",
    "            sum = sum + val\n",
    "    if sum == num:\n",
    "        print(num,end=\" \")\n",
    "end = time.time()\n",
    "print(end-start,end=\" \")"
   ]
